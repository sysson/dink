{
    "name": "dink-dev",
    "image": "mcr.microsoft.com/devcontainers/base:trixie",
    "runArgs": [
        "--privileged",
        "--device",
        "/dev/kvm"
    ],
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
            "enableNonRootDocker": "true",
            "moby": "false"
        },
        "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
            "version": "latest",
            "helm": "latest",
            "minikube": "latest"
        },
        "ghcr.io/devcontainers/features/go:1": {
            "version": "latest"
        }
    },
    "remoteUser": "vscode",
    "mounts": [
        {
            "source": "dink-config",
            "target": "/home/vscode/.config/dink",
            "type": "volume"
        },
        {
            "source": "dink-go-mod",
            "target": "/go/pkg/mod",
            "type": "volume"
        },
        {
            "source": "dink-go-sumdb",
            "target": "/go/pkg/sumdb",
            "type": "volume"
        },
        {
            "source": "dink-go-build-cache",
            "target": "/home/vscode/.cache/go-build",
            "type": "volume"
        }
    ],
    "containerEnv": {
        "DINK_CONFIG": "/home/vscode/.config/dink"
    },
    "postCreateCommand": "bash .devcontainer/post-create.sh",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-kubernetes-tools.vscode-kubernetes-tools",
                "bufbuild.vscode-buf"
            ]
        }
    }
}