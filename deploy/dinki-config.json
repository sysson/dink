{
    "log": {
        "level": "info"
    },
    "accessLog": {
        "enabled": true,
        "level": "info"
    },
    "server": {
        "port": "5000",
        "healthPort": "8080"
    },
    "tls": {
        "certFile": "/etc/dinki/tls/tls.crt",
        "keyFile": "/etc/dinki/tls/tls.key",
        "minTLSVersion": "1.3"
    },
    "storage": {
        "path": "/var/lib/dinki/blobs"
    },
    "metadata": {
        "path": "/var/lib/dinki/metadata.db"
    },
    "graphql": {
        "enabled": false
    },
    "api": {
        "clientCAFile": "/etc/dinki/tls/ca.crt",
        "clientOrganization": "dink-system",
        "clientCommonName": "dink.dink-system.svc"
    }
}