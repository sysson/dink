{
    "log": {
        "level": "info"
    },
    "accessLog": {
        "level": "info"
    },
    "kubernetes": {
        "systemNamespace": "dink-system",
        "defaultNamespace": "dink-default",
        "healthPort": "8080",
        "defaultResources": {
            "limits": {
                "cpu": "500m",
                "memory": "512Mi"
            },
            "requests": {
                "cpu": "100m",
                "memory": "128Mi"
            }
        },
        "nodePlacement": {
            "enabled": false,
            "labelKey": "dink.io/tenant",
            "tolerate": true
        }
    },
    "server": {
        "port": "2375",
        "tlsPort": "2376"
    },
    "tls": {
        "certFile": "/etc/dink/tls/tls.crt",
        "keyFile": "/etc/dink/tls/tls.key",
        "clientCAFile": "/etc/dink/tls/ca.crt",
        "minTLSVersion": "1.3"
    },
    "buildKit": {
        "url": "tcp://buildkit.dink-system.svc.cluster.local:1234",
        "caFile": "/etc/dink/tls/ca.crt",
        "certFile": "/etc/dink/tls/tls.crt",
        "keyFile": "/etc/dink/tls/tls.key",
        "serverName": "buildkit.dink-system.svc.cluster.local",
        "registryURL": "https://dinki.dink-system.svc.cluster.local:5000"
    },
    "auth": {
        "pluginDir": "/var/lib/dink/plugins"
    }
}